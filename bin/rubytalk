#!/usr/bin/env ruby
# frozen_string_literal: true

# Start RubyTalk. If ./changes.rb exists it is loaded into the environment;
# changes made in the browser are saved as you go and again on exit. The
# Transcript, a System Browser and a Workspace open at start.
#
#   rubytalk                    start in the current directory
#   rubytalk --selftest         exercise the windows with real Tk, then exit
#   rubytalk --build-app [DIR]  build a macOS RubyTalk.app with the icon
#   rubytalk --help             all options
require_relative '../lib/rubytalk'

RubyTalk::CLI.main(ARGV)
